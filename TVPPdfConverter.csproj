<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="PdfPig" Version="0.1.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Tabula" Version="0.1.5" />
    <PackageReference Include="SharpCompress" Version="0.33.0" />
  </ItemGroup>

  <!-- Copiar herramientas (pdftotext.exe, etc.) si existen en tools/ -->
  <ItemGroup>
    <Content Include="tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Excluir archivos de test del proyecto principal -->
  <ItemGroup>
    <Compile Remove="TVPPdfConverter.Tests\**" />
    <Content Remove="TVPPdfConverter.Tests\**" />
    <EmbeddedResource Remove="TVPPdfConverter.Tests\**" />
    <None Remove="TVPPdfConverter.Tests\**" />
  </ItemGroup>

</Project>
